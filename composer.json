{
    "name": "os2forms/os2forms_webform_submission_log",
    "description": "OS2Forms webform submission log",
    "license": "MIT",
    "type": "drupal-module",
    "authors": [
        {
            "name": "Mikkel Ricky",
            "email": "rimi@aarhus.dk"
        }
    ],
    "require": {
        "drupal/symfony_mailer": "^1.2",
        "drupal/webform": "^6"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "drupal/coder": "^8.3",
        "ergebnis/composer-normalize": "^2.47",
        "mglaman/phpstan-drupal": "^2.0",
        "palantirnet/drupal-rector": "^1.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "ergebnis/composer-normalize": true,
            "symfony/runtime": true
        }
    }
}
